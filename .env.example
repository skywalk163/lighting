# ============================================================
# 段言兜底生成器 · 本地密钥模板（DeepSeek 示例）
# 用法：复制本文件为同目录下的 .env，填入你的 key 即可生效
#       cp .env.example .env
# 说明：.env 不入库（已在 .gitignore 忽略）；优先级高于 llm_config.json
# ============================================================

# 你的 DeepSeek API Key（在 https://platform.deepseek.com 申请）
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# DeepSeek OpenAI 兼容端点（代码会自动拼接 /chat/completions，无需手写 /v1）
OPENAI_BASE_URL=https://api.deepseek.com

# 模型名（二选一）：
#   deepseek-chat      —— 通用对话/代码生成（推荐，便宜够用）
#   deepseek-reasoner  —— 带推理链，复杂逻辑更稳但更慢更贵
OPENAI_MODEL=deepseek-chat
